# Supabase — Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Keep secret, server-only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Gemini — used for photo classification (lib/ai/classify.ts). aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional override if the default model id goes stale. Note that Vertex
# exposes a different set of model ids than the Gemini API.
GEMINI_MODEL=gemini-2.5-flash

# Vertex AI (Gemini Enterprise Agent Platform) — optional. When BOTH of
# these are set, lib/ai/client.ts routes every Gemini call through Vertex
# instead of the AI Studio key. Worth doing: the AI Studio free tier allows
# only a few requests per minute (one WhatsApp report spends 3-4) and is
# excluded from Google Cloud's $300 trial credit, whereas Vertex is ordinary
# Cloud usage that the credit does pay for.
#   1. Enable the Vertex AI API on the project holding your credits.
#   2. Create a service account with the "Vertex AI User" role.
#   3. Add a JSON key and paste its entire contents on one line below.
GOOGLE_CLOUD_PROJECT=
GOOGLE_SERVICE_ACCOUNT_JSON=
# Defaults to "global"; only set this to pin a region.
GOOGLE_CLOUD_LOCATION=

# Google Maps Geocoding API — optional. When set, reverse-geocoding
# (lib/geo.ts) uses Google instead of the free OSM Nominatim fallback.
GOOGLE_MAPS_API_KEY=

# Kimi (Moonshot AI) — optional. Powers the AI City Briefing (admin
# analytics), the citizen help chatbot, and the officer "Draft with AI"
# resolution-note assistant. Without it, those three features return a
# clear "not configured" error; nothing else in the app depends on them.
KIMI_API_KEY=
KIMI_API_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k3

# WhatsApp (Meta Cloud API) — optional. See README "WhatsApp integration"
# for setup steps. Without these, WhatsApp OTP login runs in a dev/demo
# mode (code is logged + returned instead of sent) and the reporting
# webhook has nothing to receive.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Local development only. When WhatsApp isn't configured the OTP endpoint
# fails closed, because returning the code to the caller would let anyone
# sign in as any phone number. Set this to "true" (non-production only) to
# get the code back in the API response for local testing instead.
WHATSAPP_ALLOW_DEV_OTP=
WHATSAPP_OTP_TEMPLATE_NAME=

# Cloudflare R2 — optional photo storage. When all four are set, issue
# photos upload to R2 instead of Supabase Storage; otherwise the app
# falls back to Supabase automatically (see lib/storage.ts).
# Create an R2 API token: Cloudflare dash -> R2 -> Manage API tokens
# (Object Read & Write). Enable public access on the bucket to get an
# r2.dev URL, or attach a custom domain, and put that in R2_PUBLIC_BASE_URL.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=janreport-photos
R2_PUBLIC_BASE_URL=

# Web Push — optional. Generate with `node scripts/generate-vapid-keys.mjs`.
# Without these, geofenced alerts still work in-app (bell + toast while a
# tab is open) but skip the browser push notification.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@janreport.demo

# Resend — optional. Sends citizens a report acknowledgement and status
# updates by email (lib/email/). Without it those sends are skipped and a
# warning is logged; nothing else changes. The sending domain must be
# verified in Resend, otherwise the API rejects the from address.
RESEND_API_KEY=
EMAIL_FROM=JanReport <noreply@janreport.xyz>
